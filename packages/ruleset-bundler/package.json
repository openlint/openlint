{
  "name": "@openlint/openlint-ruleset-bundler",
  "version": "0.0.1",
  "homepage": "https://github.com/openlint/openlint",
  "bugs": "https://github.com/openlint/openlint/issues",
  "author": "OpenLint <info@openlint.org>",
  "engines": {
    "node": "^22.0 || >= 24.0"
  },
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "type": "commonjs",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./with-loader": {
      "node": "./dist/loader/node.js",
      "browser": "./dist/loader/browser.js",
      "default": "./dist/loader/node.js"
    },
    "./presets/*": {
      "default": "./dist/presets/*.js"
    },
    "./plugins/*": {
      "default": "./dist/plugins/*.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openlint/openlint.git"
  },
  "dependencies": {
    "@openlint/openlint-core": "0.x",
    "@openlint/openlint-formats": "0.x",
    "@openlint/openlint-functions": "0.x",
    "@openlint/openlint-parsers": "^1.0.0",
    "@openlint/openlint-ref-resolver": "0.x",
    "@openlint/openlint-ruleset-migrator": "0.x",
    "@openlint/openlint-rulesets": "0.x",
    "@openlint/openlint-runtime": "0.x",
    "@rollup/plugin-commonjs": "~22.0.2",
    "@stoplight/path": "1.3.2",
    "@stoplight/types": "^13.6.0",
    "@types/node": "*",
    "rollup": "^2.80.0",
    "tslib": "^2.8.1",
    "validate-npm-package-name": "3.0.0"
  },
  "devDependencies": {
    "@types/validate-npm-package-name": "^3.0.3",
    "fetch-mock": "^12.6.0",
    "memfs": "^3.5.3",
    "prettier": "^3.0.0",
    "vitest": "^5.0.5"
  }
}
