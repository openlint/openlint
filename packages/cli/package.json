{
  "name": "openlint",
  "version": "1.0.0",
  "homepage": "https://github.com/openlint/openlint",
  "bugs": "https://github.com/openlint/openlint/issues",
  "author": "OpenLint <info@openlint.org>",
  "bin": "./dist/index.js",
  "engines": {
    "node": "^22.0 || >= 24.0"
  },
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openlint/openlint.git"
  },
  "scripts": {
    "prelint": "node ../../scripts/inline-version.mjs",
    "prepare": "node ../../scripts/inline-version.mjs",
    "prebuild": "node ../../scripts/inline-version.mjs",
    "build.binary": "pkg . --output ./binaries/openlint",
    "build.windows": "pkg . --targets windows --out-path ./binaries",
    "build.nix": "pkg . --targets linux-x64,linux-arm64,macos-x64,macos-arm64,alpine-x64,alpine-arm64 --out-path ./binaries",
    "cli": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/index.ts",
    "cli:debug": "node -r ts-node/register/transpile-only -r tsconfig-paths/register --inspect-brk src/index.ts"
  },
  "dependencies": {
    "@openlint/openlint-core": "0.0.1",
    "@openlint/openlint-formatters": "0.0.2",
    "@openlint/openlint-parsers": "0.0.1",
    "@openlint/openlint-ref-resolver": "0.0.1",
    "@openlint/openlint-ruleset-bundler": "0.0.1",
    "@openlint/openlint-ruleset-migrator": "0.0.1",
    "@openlint/openlint-rulesets": "0.0.1",
    "@openlint/openlint-runtime": "0.0.1",
    "@stoplight/json": "~3.21.0",
    "@stoplight/path": "1.3.2",
    "@stoplight/types": "^13.6.0",
    "chalk": "^4.1.2",
    "fast-glob": "~3.2.12",
    "hpagent": "~1.2.0",
    "lodash": "^4.18.1",
    "stacktracey": "^2.1.8",
    "tslib": "^2.8.1",
    "yargs": "~17.7.2"
  },
  "devDependencies": {
    "@types/xml2js": "^0.4.9",
    "@types/yargs": "^17.0.8",
    "@yao-pkg/pkg": "6.22.0",
    "nock": "^13.5.4",
    "tsconfig-paths": "^4.2.0",
    "vitest": "^5.0.5",
    "xml2js": "^0.5.0"
  },
  "pkg": {
    "scripts": [
      "./dist/**/*.js",
      "../../node_modules/async-function/index.js",
      "../../node_modules/async-generator-function/index.js",
      "../../node_modules/generator-function/index.js"
    ],
    "assets": [
      "./dist/**/*.json",
      "../*/dist/**/*.js.map",
      "../*/src/**/*.ts"
    ],
    "options": [
      "no-experimental-require-module"
    ]
  }
}
