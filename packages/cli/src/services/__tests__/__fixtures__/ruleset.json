{
  "rules": {
    "info-matches-openlint": {
      "message": "Info must contain OpenLint",
      "given": "$.info",
      "recommended": true,
      "then": {
        "field": "title",
        "function": "pattern",
        "functionOptions": {
          "match": "OpenLint"
        }
      }
    }
  }
}
